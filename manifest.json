{
  "manifest_version": 3,
  "name": "JapanRefactor",
  "version": "0.4.0",
  "description": "Subtítulos duales y vocabulario para aprender japonés en YouTube",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dict/*", "jmdict.tsv.gz"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
